---
import Base from "../layouts/Base.astro";
import { assetManifest } from "../lib/assets.ts";
import { renderDocument } from "../lib/render/index.ts";
import { markdownProcessor } from "../lib/render/markdown.ts";
const host = Astro.site!.host;
const fence = "```";
const swift = `let domain = "${host}"
let code = 404
let userInfo = [
    NSLocalizedDescriptionKey:
        "Requested page is too obscure, and probably does not exist.",
    NSLocalizedRecoverySuggestionErrorKey:
        "Go back to the mainstream site."
]

throw NSError(domain: domain, code: code, userInfo: userInfo)`;
const objc = `NSString *domain = @"${host}";
NSInteger code = 404;
NSDictionary *userInfo = @{
    NSLocalizedDescriptionKey:
        @"Requested page is too obscure, and probably does not exist.",
    NSLocalizedRecoverySuggestionErrorKey:
        @"Go back to the mainstream site."
};

NSError *error = [[NSError alloc] initWithDomain:domain
                                            code:code
                                        userInfo:userInfo];`;
const body = `\n${fence}swift\n${swift}\n${fence}\n\n${fence}objc\n${objc}\n${fence}\n`;

const renderer = await markdownProcessor().createRenderer({ syntaxHighlight: false });
const { html } = await renderDocument(body, {
  file: "src/pages/404.astro",
  page: { title: "NSError 404 - NSHipster", url: "/404.html" },
  assets: assetManifest(),
  markdown: async (markdown) => (await renderer.render(`\n${markdown}`)).code,
});
---

<Base title="NSError 404 - NSHipster" path="/404.html">
  <article role="article">
    <h1 class="title">NSError</h1>

    <div class="content" set:html={html} />
  </article>
</Base>
