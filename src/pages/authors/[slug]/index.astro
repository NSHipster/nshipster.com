---
import { getCollection, render } from "astro:content";
import Avatar from "../../../components/Avatar.astro";
import Base from "../../../layouts/Base.astro";
import { authorDescription, authorURL, postsNewestFirst } from "../../../lib/collections.ts";
import { formatDate } from "../../../lib/dates.ts";
import { t } from "../../../lib/i18n.ts";

export async function getStaticPaths() {
  return (await getCollection("authors")).map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props;
const { name } = author.data;
const { Content } = await render(author);
const posts = (await postsNewestFirst()).filter((post) => post.data.author === name || post.data.authors.includes(name));
const latest = posts[0]?.data.updatedOn;
const url = authorURL(author);
const description = await authorDescription(author);
---

<Base
  title={author.data.title}
  path={url}
  creator={author.data.twitter}
  document={{
    description,
    published: latest?.toISOString() ?? "",
    modified: latest?.toISOString() ?? "",
  }}
  article={{
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    mainEntity: {
      "@type": "Person",
      name,
      url: new URL(url, Astro.site).href,
      ...(author.data.website ? { sameAs: [author.data.website] } : {}),
    },
  }}
>
  <article class="author">
    <header>
      <Avatar name={name} image={author.data.image} gravatar={author.data.gravatar} />
      <h1>{name}</h1>

      <Content />
    </header>

    <section class="archive">
      <h1>{t.articles}</h1>

      <ol>
        {
          posts.map((post) => {
            return (
              <li>
                <a href={post.data.url} title={post.data.title} class="title" set:html={post.data.title} />
                <time datetime={post.data.date.toISOString()} set:html={formatDate(post.data.date)} />

                <Fragment set:html={post.data.excerptHTML} />
              </li>
            );
          })
        }
      </ol>
    </section>
  </article>
</Base>
