---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import sosumiIcon from "../../assets/images/projects/sosumi.png";
import trifleIcon from "../../assets/images/projects/trifle.png";
import Base from "../layouts/Base.astro";
import { postsListedNewestFirst, postsNewestFirst } from "../lib/collections.ts";
import { byCodeUnit } from "../lib/content/posts.ts";
import { t } from "../lib/i18n.ts";
import { site } from "../lib/site.ts";
import { camelBreak, plainText, stripHTML, titleHTML } from "../lib/text.ts";

// Each project's icon, keyed by its `id` in `site.projects`.
const projectIcons = { sosumi: sosumiIcon, trifle: trifleIcon } satisfies Record<
  (typeof site.projects)[number]["id"],
  ImageMetadata
>;

const posts = await postsNewestFirst();
const sorted = await postsListedNewestFirst();
const [latest, ...rest] = sorted;
const recent = rest.slice(0, 6);
const title = (value: string) => titleHTML(stripHTML(value));
const archiveTitle = (value: string) => camelBreak(stripHTML(value));

// Categories appear in the configured order, if they have any articles.
const archive = site.groups
  .map((group) => ({ group, posts: posts.filter((post) => post.data.category === group) }))
  .filter(({ posts }) => posts.length > 0)
  .map(({ group, posts }) => ({
    group,
    posts: posts.sort((a, b) => byCodeUnit(a.data.title, b.data.title)).filter((post) => !post.data.retired),
  }));
---

<Base title="NSHipster" path="/" home>
  {
    latest && (
      <section id="latest">
        <article>
          <header>
            <h2 class="title">
              <a href={latest.data.url} data-astro-prefetch>
                <Fragment set:html={title(latest.data.title)} />
              </a>
            </h2>
          </header>

          <Fragment set:html={latest.data.excerptHTML} />

          <a class="readmore" href={latest.data.url} data-astro-prefetch>
            {t.continueReading}<span class="visually-hidden">: {plainText(latest.data.title)}</span>
          </a>
        </article>
      </section>
    )
  }

  {
    sorted.length > 3 && (
      <section id="recent">
        <h2>{t.recentArticles}</h2>

        <ul>
          {recent.map((post) => (
            <li>
              <a class="title" href={post.data.url}>
                <Fragment set:html={title(post.data.title)} />
              </a>

              <Fragment set:html={post.data.excerptHTML} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="projects">
    <h2>{t.moreFromNSHipster}</h2>

    <ul>
      {
        site.projects.map((project) => (
          <li>
            <a class="project" href={project.url}>
              <Image
                class="icon"
                src={projectIcons[project.id]}
                alt=""
                width={192}
                aria-hidden="true"
                draggable="false"
              />
              <div class="text">
                <h3>{project.name}</h3>
                <small>{new URL(project.url).host}</small>
                <p>{project.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="archive" class="archive" role="navigation">
    {
      archive.map(({ group, posts }) => (
        <dl>
          <dt>{group}</dt>
          {posts.map((post) => (
            <dd>
              <a href={post.data.url}>{archiveTitle(post.data.title)}</a>
            </dd>
          ))}
        </dl>
      ))
    }
  </section>
</Base>
