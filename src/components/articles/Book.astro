---
import AssetImage from "./AssetImage.astro";
import JsonLd from "../JsonLd.astro";
import { assetManifest } from "../../lib/assets.ts";
import { readBooks } from "../../lib/content/books.ts";
import { renderFragment } from "../../lib/render/index.ts";
import { bookJSONLD } from "../../lib/render/partials.ts";
import { processorRenderer } from "../../lib/render/renderer.ts";

interface Props {
  /** The book name from `src/content/books`, such as `flight-school-guide-to-swift-codable`. */
  name?: string;
  primary?: string;
  /** Set for the first cover on a page. Other covers load lazily. */
  eager?: boolean;
}

const { name, primary, eager = false } = Astro.props;
const bookName = name ?? (typeof primary === "string" ? primary : "");
const book = readBooks().find((candidate) => candidate.name === bookName);
if (!book) throw new Error(`Unknown book "${bookName}"`);
const summaryHTML = await renderFragment(book.summary, await processorRenderer());
---

<div id={book.name} class="book">
  <a href={book.bookURL} title={book.title} rel="noopener noreferrer" target="_blank">
    <AssetImage name={book.image} alt={book.title} class="cover" eager={eager} />
  </a>
  <JsonLd data={bookJSONLD(book, assetManifest().url(book.image), summaryHTML)} />
</div>
