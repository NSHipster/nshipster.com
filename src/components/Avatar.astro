---
import { Image } from "astro:assets";
import { portrait } from "../lib/images.ts";

interface Props {
  name: string;
  image?: string | undefined;
  gravatar?: string | undefined;
}

const { name, image, gravatar } = Astro.props;
---

{
  image ? (
    <Image class="avatar" alt={name} src={portrait(image)} width={300} draggable="false" />
  ) : (
    <img class="avatar" alt={name} src={`https://0.gravatar.com/avatar/${gravatar ?? ""}?size=300`} draggable="false" />
  )
}
