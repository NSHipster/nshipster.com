---
import Base from "./Base.astro";
import Contributor from "../components/Contributor.astro";
import JsonLd from "../components/JsonLd.astro";
import { authorNamed, authorPerson, authorURL, type Post } from "../lib/collections.ts";
import type { PostEntryData } from "../lib/content/loaders.ts";
import { formatDate } from "../lib/dates.ts";
import { t } from "../lib/i18n.ts";
import { camelBreak, plainText, stripHTML } from "../lib/text.ts";

interface Props {
  /** Normalized post data, from either the legacy loader or an MDX entry. */
  post: PostEntryData;
  /** Whether the entry is an article, as opposed to a page with the article layout. */
  isArticle: boolean;
  next?: Post | undefined;
  previous?: Post | undefined;
  /** The article to suggest reading next. */
  continueWith?: Post | undefined;
}

const { post, isArticle, next, previous, continueWith } = Astro.props;
const author = await authorNamed(post.author);
const coauthors = await Promise.all(post.authors.map(async (name) => ({ name, author: await authorNamed(name) })));
// Some older articles credit coauthors only in `author`, as in "Nate Cook, Mattt".
const creditedNames = post.authors.length > 0 ? post.authors : (post.author ?? "Mattt").split(/\s*[,&]\s*/);
const credited = await Promise.all(
  creditedNames.map(async (name) => {
    const entry = await authorNamed(name);
    return entry ? authorPerson(entry) : { "@type": "Person", name };
  }),
);
const title = camelBreak(stripHTML(post.title));
const absolute = (path: string) => new URL(path, Astro.site).href;
const shown = post.lastRevisedOn ?? post.date;
const swift = post.status?.swift;
const hasSwiftVersion = swift && swift !== "t.b.c." && swift !== "n/a";
const description = plainText(post.excerptHTML);
---

<Base
  title={post.title}
  path={post.url}
  document={isArticle
    ? {
        description,
        category: post.category,
        categories: post.category ? [post.category] : [],
        published: post.date.toISOString(),
        modified: post.updatedOn.toISOString(),
      }
    : undefined}
  article={isArticle
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: stripHTML(post.title).trim(),
        description,
        image: absolute("/logo.png"),
        datePublished: post.date.toISOString(),
        dateModified: post.updatedOn.toISOString(),
        mainEntityOfPage: { "@type": "WebPage", "@id": absolute(post.url) },
        author: credited.length === 1 ? credited[0] : credited,
        publisher: {
          "@type": "Organization",
          name: "NSHipster",
          logo: { "@type": "ImageObject", url: absolute("/logo.png") },
        },
        speakable: {
          "@type": "SpeakableSpecification",
          xpath: ["/html/head/title", "/html/head/meta[@name='description']/@content"],
        },
      }
    : undefined}
  creator={isArticle ? author?.data.twitter : undefined}
  next={next?.data.url}
  previous={previous?.data.url}
  noindex={post.retired}
>
  <article role="article">
    <header>
      <h1 class="title">
        <a href={post.url}>{title}</a>
      </h1>

      <div class="byline">
        {
          coauthors.length > 0 ? (
            <>
              {t.writtenBy}{" "}
              <span class="authors">
                {coauthors.map(({ name, author }, index) => (
                  <>
                    {index === coauthors.length - 1 && "& "}
                    <a rel="author" class="author" href={author ? authorURL(author) : undefined}>
                      {author?.data.name ?? name}
                    </a>{" "}
                  </>
                ))}
              </span>
              <wbr />
            </>
          ) : author ? (
            <>
              {t.writtenBy}{" "}
              <span class="authors">
                <a class="author" href={authorURL(author)}>{author.data.name}</a>
              </span>
            </>
          ) : (
            post.author && (
              <>
                {t.writtenBy} <span class="authors">{post.author}</span>
              </>
            )
          )
        }

        {" "}<time datetime={shown.toISOString()} set:html={formatDate(shown)} />{" "}

        {
          post.revisions.length > 0 &&
            (post.commitHistoryURL ? (
              <>
                (<a href={encodeURI(post.commitHistoryURL)} rel="noopener noreferrer">{t.revised}</a>)
              </>
            ) : (
              <>({t.revised})</>
            ))
        }
      </div>
    </header>

    <div class="content">
      <slot />
    </div>

    <footer>
      {
        (post.revisions.length > 0 || post.status) && (
          <section id="revisions">
            <small>NSMutableHipster</small>

            <p>
              Questions? Corrections? <a href="https://github.com/NSHipster/articles/issues">Issues</a> and{" "}
              <a href={`https://github.com/NSHipster/articles/blob/master/${post.sourcePath}`}>pull requests</a> are always
              welcome.
            </p>

            <p class="status">
              {
                hasSwiftVersion ? (
                  <>
                    {post.status?.reviewed ? (
                      <em>
                        This article uses Swift version {swift} and was last reviewed on {post.status.reviewed}.
                      </em>
                    ) : (
                      <em>This article uses Swift version {swift}.</em>
                    )}{" "}
                    Find status information for all articles on the <a href="/status">status page</a>.
                  </>
                ) : (
                  post.status?.reviewed && <em>This article was last reviewed on {post.status.reviewed}.</em>
                )
              }
            </p>
          </section>
        )
      }

      <section id="attribution">
        <Contributor author={author} />
      </section>

      <section>
        {
          continueWith && continueWith.data.url !== post.url && (
            <div id="continue">
              <small>{t.nextArticle}</small>
              <article>
                <h2 class="title">
                  <a rel="next" href={continueWith.data.url} data-astro-prefetch>
                    {camelBreak(stripHTML(continueWith.data.title))}
                  </a>
                </h2>

                <Fragment set:html={continueWith.data.excerptHTML} />
              </article>
            </div>
          )
        }
      </section>
    </footer>
  </article>

  <JsonLd
    data={{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, item: { "@id": Astro.site!.origin, name: "Articles" } },
        { "@type": "ListItem", position: 2, item: { "@id": absolute(post.url), name: stripHTML(post.title) } },
      ],
    }}
  />
</Base>
