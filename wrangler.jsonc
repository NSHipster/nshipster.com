{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets with a small Worker (`src/worker.ts`) for the few paths
  // that need a response at request time. No server rendering or database.
  "name": "nshipster",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "nshipster.com", "custom_domain": true }],
  // Keep the workers.dev URL and Preview URLs, which Wrangler enables by default.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // `/nscache` serves `nscache.html`, and `/nscache/` redirects to it.
    "html_handling": "auto-trailing-slash",
    // Requests that match no asset or redirect run the Worker, which serves the 404 page.
    // Cloudflare's "404-page" handling would serve it with the headers of the requested path,
    // which caches a missing `/assets/` file for a year.
    "not_found_handling": "none",
    // These paths run the Worker before the static assets.
    // `security.txt` is generated per request so that its `Expires` date stays in the future.
    "run_worker_first": ["/.well-known/security.txt"],
  },
  // Pull request builds run `wrangler preview`, which requires this block.
  "previews": {},
}
